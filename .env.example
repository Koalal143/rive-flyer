# Ключ браузерного JavaScript API 3.0. Ограничьте по HTTP Referer.
YANDEX_MAPS_API_KEY=
# Серверный ключ API Поиска по организациям. Не добавляйте во frontend.
YANDEX_SEARCH_API_KEY=
# Серверный ключ HTTP API Геокодера, только для подготовки каталога.
YANDEX_GEOCODER_API_KEY=
# В Docker, например, /app/data/stores.json.
STORE_CATALOG_PATH=
# Локальный порт Grafana и пароли PostgreSQL для первого запуска.
GRAFANA_PORT=3010
ANALYTICS_DB_PASSWORD=local-analytics-writer
ANALYTICS_READER_PASSWORD=local-analytics-reader
